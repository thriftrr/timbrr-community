// Cloudflare config for the starter as the studio's canvas. `nuxt build`
// merges this into .output/server/wrangler.json, which `make deploy` ships.
// A client site copied from the starter gives it its own name and domain.
{
 "$schema": "../node_modules/wrangler/config-schema.json",
 "name": "timbrr-canvas",
 "account_id": "7a16cc804ef680614283102ffad99469",
 "compatibility_date": "2025-08-01",
 // Query strings can hold tokens and what visitors typed, so logs leave them out.
 "observability": { "enabled": true, "redact_query_string": true },
 "routes": [{ "pattern": "canvas.timbrr.app", "custom_domain": true }],
 // The only studio whose messages the canvas takes and that may frame it
 // (read per request, so changing it here needs a deploy, not a rebuild).
 "vars": { "NUXT_PUBLIC_STUDIO_ORIGIN": "https://timbrr.app" },
 // Timbrr Analytics counts into this dataset (src/layer/server/utils/analytics.js,
 // docs/analytics.md). A Worker without the binding serves its pages as
 // before and counts nothing, so a client site copied from this file adds
 // it when it wants to count. The dataset is made by the first write; the
 // account needs Workers Analytics Engine turned on once. Environments don't
 // inherit it: `timbrr` and `hosted` carry their own, and `preview` leaves
 // it out on purpose, since a draft is never counted.
 "analytics_engine_datasets": [{ "binding": "TIMBRR_HITS", "dataset": "timbrr_hits" }],
 "env": {
  // The Timbrr marketing site: the same build deployed a second time as
  // its own Worker on the apex domain, serving what the studio publishes
  // for its built-in `timbrr` site (the studio's docs/timbrr-site.md). The
  // studio keeps its own paths (/forestrr, /api, /auth, /help, /media,
  // /oauth, /mcp, /.well-known) through more specific routes in its own
  // wrangler.jsonc; this Worker gets everything else on timbrr.app. The
  // Timbrr team deploys it with `make deploy-timbrr`. An environment
  // inherits the Worker's main and assets but not its vars, so every var
  // the site needs is set here.
  "timbrr": {
   "name": "timbrr-site",
   "routes": [{ "pattern": "timbrr.app/*", "zone_name": "timbrr.app" }],
   // One request in ten is logged: enough to see a problem, less cost and less held about visitors.
   "observability": { "enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true },
   "analytics_engine_datasets": [{ "binding": "TIMBRR_HITS", "dataset": "timbrr_hits" }],
   "vars": {
    "NUXT_PUBLIC_SITE": "timbrr",
    "NUXT_PUBLIC_STUDIO_ORIGIN": "https://timbrr.app",
    "NUXT_TIMBRR_API": "https://timbrr.app",
    // Same origin as the studio, so a script that got into a page here
    // would run beside studio sessions: enforce script-src 'self'.
    "NUXT_TIMBRR_SCRIPT_POLICY": "enforce"
   }
  },
  // Every launch domain: the same build again, with no site set. A domain
  // reaches it through Cloudflare for SaaS, the customer's CNAME pointing at
  // sites.timbrr.app, and the studio says which site that hostname is
  // (src/layer/server/middleware/hosted.js). `make deploy-hosted` ships it.
  // Needs Cloudflare for SaaS on the zone with sites.timbrr.app as its
  // fallback origin, a proxied DNS record for that name, and this route
  // (the studio's docs/sites.md, "Launch domain"). The route is the
  // catch-all: a launch domain keeps its own host name, so no route naming
  // a timbrr.app host ever matches it, and a route made by hand is removed
  // by the next deploy. It also catches every proxied timbrr.app host with
  // no route of its own, so those need a route with no Worker, made once
  // on the zone (media.timbrr.app/*, canvas.timbrr.app/*): this file can't
  // hold them.
  "hosted": {
   "name": "timbrr-sites",
   "routes": [{ "pattern": "*/*", "zone_name": "timbrr.app" }],
   "observability": { "enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true },
   "analytics_engine_datasets": [{ "binding": "TIMBRR_HITS", "dataset": "timbrr_hits" }],
   "vars": {
    "NUXT_PUBLIC_STUDIO_ORIGIN": "https://timbrr.app",
    "NUXT_TIMBRR_API": "https://timbrr.app",
    "NUXT_TIMBRR_HOSTED": "true"
   }
  },
  // Every site's dev and staging addresses, for sites with no code of their
  // own: the same build again, with no site set, since the address names
  // it (src/layer/server/middleware/preview.js). A site with its own Worker
  // adds routes for its own two hostnames, which win over these. The studio
  // reaches nobody here: these are routes, and it's reached over its custom
  // domain. `make deploy-preview` ships it. Needs a certificate covering
  // both wildcards, and proxied DNS records for them (the studio's
  // docs/sites.md, "Dev and staging addresses").
  "preview": {
   "name": "timbrr-preview",
   "routes": [
    { "pattern": "*.dev.timbrr.app/*", "zone_name": "timbrr.app" },
    { "pattern": "*.staging.timbrr.app/*", "zone_name": "timbrr.app" }
   ],
   "observability": { "enabled": true, "redact_query_string": true },
   "vars": {
    "NUXT_PUBLIC_STUDIO_ORIGIN": "https://timbrr.app",
    "NUXT_TIMBRR_API": "https://timbrr.app"
   }
  }
 }
}
