{
  // Timbrr Community workspace theme, drawn from the blocks' own palette:
  // pine #2f6b4f (brand), ink #1f2a22, paper #f7f5ec, sage #b9c9b3,
  // mint #8fd3aa, gold #e0a82e. Layered over whatever base theme is active.
  "window.title": "🌲 Timbrr Community — ${activeEditorShort}${separator}${rootName}",
  "workbench.colorCustomizations": {
    // Title bar: pine, so the window is recognizable at a glance.
    "titleBar.activeBackground": "#2f6b4f",
    "titleBar.activeForeground": "#f7f5ec",
    "titleBar.inactiveBackground": "#2f6b4fb3",
    "titleBar.inactiveForeground": "#f7f5ecb3",
    "titleBar.border": "#f7f5ec2e",
    "commandCenter.background": "#1f2a2266",
    "commandCenter.foreground": "#f7f5ec",
    "commandCenter.activeBackground": "#1f2a2299",
    "commandCenter.border": "#8fd3aa55",

    // Activity bar: ink, with a mint indicator and gold badges.
    "activityBar.background": "#27382d",
    "activityBar.foreground": "#f7f5ec",
    "activityBar.inactiveForeground": "#b9c9b399",
    "activityBar.activeBorder": "#8fd3aa",
    "activityBar.activeBackground": "#2f6b4f55",
    "activityBar.border": "#f7f5ec2e",
    "activityBarBadge.background": "#e0a82e",
    "activityBarBadge.foreground": "#1f2a22",

    // Status bar: pine again, so both edges of the window say Timbrr.
    "statusBar.background": "#2f6b4f",
    "statusBar.foreground": "#f7f5ec",
    "statusBar.border": "#f7f5ec2e",
    "statusBar.noFolderBackground": "#2f6b4f",
    "statusBar.debuggingBackground": "#e0a82e",
    "statusBar.debuggingForeground": "#1f2a22",
    "statusBarItem.hoverBackground": "#3d8563",
    "statusBarItem.remoteBackground": "#27382d",
    "statusBarItem.remoteForeground": "#8fd3aa",

    // The panes: ink-green shades instead of the base theme's near-black,
    // so the inside of the window belongs with the pine chrome around it.
    // Editor is the deepest, sidebar and panel sit level with the activity bar.
    "foreground": "#e6e4d8",
    "widget.border": "#f7f5ec2e",
    "editor.background": "#213026",
    "editor.foreground": "#e6e4d8",
    "editor.lineHighlightBackground": "#2f6b4f1f",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#2f6b4f80",
    "editor.inactiveSelectionBackground": "#2f6b4f40",
    "editorLineNumber.foreground": "#5d6b61",
    "editorLineNumber.activeForeground": "#b9c9b3",
    "editorGutter.background": "#213026",
    "editorIndentGuide.background1": "#33473a",
    "editorIndentGuide.activeBackground1": "#4d6a58",
    "editorWidget.background": "#27382d",
    "editorWidget.border": "#f7f5ec2e",
    "editorHoverWidget.background": "#27382d",
    "editorHoverWidget.border": "#f7f5ec2e",
    "editorSuggestWidget.background": "#27382d",
    "editorSuggestWidget.border": "#f7f5ec2e",
    "editorSuggestWidget.selectedBackground": "#2f6b4f66",
    "editorGroup.border": "#f7f5ec2e",
    "editorGroupHeader.tabsBackground": "#24342a",
    "editorGroupHeader.tabsBorder": "#f7f5ec2e",
    "editorGroupHeader.noTabsBackground": "#24342a",
    "tab.activeBackground": "#213026",
    "tab.activeForeground": "#f7f5ec",
    "tab.inactiveBackground": "#24342a",
    "tab.inactiveForeground": "#8a968c",
    "tab.hoverBackground": "#27382d",
    "tab.border": "#f7f5ec2e",
    "breadcrumb.background": "#213026",
    "sideBar.background": "#27382d",
    "sideBar.foreground": "#d9dccf",
    "sideBar.border": "#f7f5ec2e",
    "sideBarTitle.foreground": "#f7f5ec",
    "sideBarSectionHeader.background": "#27382d",
    "sideBarSectionHeader.foreground": "#b9c9b3",
    "list.hoverBackground": "#2f6b4f33",
    "list.activeSelectionBackground": "#2f6b4f80",
    "list.activeSelectionForeground": "#f7f5ec",
    "list.inactiveSelectionBackground": "#2f6b4f4d",
    "list.focusOutline": "#8fd3aa66",
    "panel.background": "#27382d",
    "panel.border": "#f7f5ec2e",
    "panelTitle.activeForeground": "#f7f5ec",
    "panelTitle.inactiveForeground": "#8a968c",
    "terminal.background": "#27382d",
    "terminal.foreground": "#e6e4d8",
    "terminalCursor.foreground": "#8fd3aa",
    "input.background": "#213026",
    "input.border": "#f7f5ec2e",
    "input.foreground": "#e6e4d8",
    "dropdown.background": "#213026",
    "dropdown.border": "#f7f5ec2e",
    "quickInput.background": "#27382d",
    "menu.background": "#27382d",
    "menu.selectionBackground": "#2f6b4f80",
    "notifications.background": "#27382d",
    "scrollbarSlider.background": "#4d6a5866",
    "scrollbarSlider.hoverBackground": "#4d6a58aa",
    "scrollbarSlider.activeBackground": "#2f6b4f",

    // Small accents through the rest of the chrome.
    "tab.activeBorderTop": "#8fd3aa",
    "panelTitle.activeBorder": "#8fd3aa",
    "sideBarSectionHeader.border": "#2f6b4f",
    "focusBorder": "#2f6b4f",
    "progressBar.background": "#8fd3aa",
    "badge.background": "#2f6b4f",
    "badge.foreground": "#f7f5ec",
    "button.background": "#2f6b4f",
    "button.foreground": "#f7f5ec",
    "button.hoverBackground": "#3d8563",
    "editorCursor.foreground": "#8fd3aa",
    "editor.selectionHighlightBorder": "#2f6b4f"
  }
}
